{
  "name": "zhiyi-campus-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "node tests/run-e2e.mjs --grep-invert @system",
    "pretest:system": "npm run build",
    "test:system": "node tests/run-e2e.mjs --grep @system",
    "test:all": "npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "1.19.0",
    "element-plus": "2.14.4",
    "pinia": "4.0.2",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.2",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
